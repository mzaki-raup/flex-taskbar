<Window x:Class="FlexTaskbar.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlexTaskbar Settings"
        Icon="pack://application:,,,/Resources/App.ico"
        Width="440"
        Height="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="{StaticResource TaskbarBackgroundBrush}"
        Foreground="{StaticResource TaskbarForegroundBrush}"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TaskbarForegroundBrush}" />
        </Style>
        <!-- Same root cause as the TabItem/ComboBox fix below: the default
             CheckBox/RadioButton ControlTemplate uses system theme colors for the
             label text, ignoring a plain Foreground Setter — against this dark
             theme that rendered as barely-visible black-on-dark text (round-4
             feedback). Explicit templates, not just a Setter, are what actually
             fixes it. -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TaskbarForegroundBrush}" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="16" Height="16" Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource ItemHoverBrush}"
                                    BorderBrush="{StaticResource TaskbarBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                <Path x:Name="CheckMark"
                                      Data="M2,6 L6,10 L14,2"
                                      Stroke="{StaticResource TaskbarForegroundBrush}"
                                      StrokeThickness="2"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{StaticResource TaskbarForegroundBrush}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TaskbarForegroundBrush}" />
            <Setter Property="Margin" Value="0,4,16,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Circle" Width="16" Height="16" Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource ItemHoverBrush}"
                                    BorderBrush="{StaticResource TaskbarBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource TaskbarForegroundBrush}" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{StaticResource TaskbarForegroundBrush}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- BasedOn the implicit TextBlock style above so this still gets its
             Foreground — an x:Key style doesn't automatically inherit a
             same-TargetType implicit style's setters just by being applied to
             the same element type. -->
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>

        <!-- WPF's default TabItem/TabControl chrome uses system theme colors for the
             header text and content-area background, ignoring the window's own
             Foreground/Background — against this dark theme that renders as
             invisible (dark-on-dark or white-on-white) text. Explicit templates
             here, rather than relying on inheritance, are what actually guarantee
             visibility regardless of the current Windows theme. -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="HeaderBorder"
                                Background="Transparent"
                                CornerRadius="4,4,0,0"
                                Margin="0,0,2,0"
                                Padding="12,7">
                            <ContentPresenter ContentSource="Header"
                                               VerticalAlignment="Center"
                                               TextElement.Foreground="{StaticResource TaskbarSubtleForegroundBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource ItemHoverBrush}" />
                                <Setter TargetName="HeaderBorder" Property="TextElement.Foreground" Value="{StaticResource TaskbarForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource ItemHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <TabPanel DockPanel.Dock="Top" IsItemsHost="True" Background="Transparent" />
                            <Border Background="{StaticResource TaskbarBackgroundBrush}">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Default ComboBox chrome is a white dropdown box with black text — legible
             on its own, but jarring against this dark theme. Restyled to match. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource TaskbarBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TaskbarForegroundBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource ItemHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TaskbarForegroundBrush}" />
            <Setter Property="Background" Value="{StaticResource ItemHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TaskbarBorderBrush}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="20" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="▾" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TaskbarSubtleForegroundBrush}" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                               IsHitTestVisible="False"
                                               Content="{TemplateBinding SelectionBoxItem}"
                                               ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                               Margin="{TemplateBinding Padding}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               TextElement.Foreground="{StaticResource TaskbarForegroundBrush}" />
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{StaticResource TaskbarBackgroundBrush}" BorderBrush="{StaticResource TaskbarBorderBrush}" BorderThickness="1" CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource TaskbarBorderBrush}" BorderThickness="1">
    <DockPanel>
        <!-- Custom header, not the OS title bar (round-5 feedback: "settings title
             ... still showing black text" — WPF windows don't participate in dark
             mode automatically, so the native title bar renders with whatever
             black-on-light chrome the current Windows theme happens to use,
             regardless of this app's own theme. A self-drawn header, same
             approach TaskbarWindow/LauncherWindow already use, is immune to that
             — it's always themed correctly since it's just our own XAML.) -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ItemHoverBrush}"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid Margin="10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="pack://application:,,,/Resources/App.ico" Width="16" Height="16" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="FlexTaskbar Settings" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Button Grid.Column="2" Content="✕" Width="28" Height="22" Padding="0"
                        Style="{StaticResource TaskbarButtonStyle}" Click="Close_Click" />
            </Grid>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,12,12,12">
            <Button Content="Close" Width="90" Click="Close_Click" Style="{StaticResource TaskbarButtonStyle}" />
        </StackPanel>

        <TabControl Margin="12,12,12,0">
            <TabItem Header="General">
                <StackPanel Margin="8" Background="{StaticResource TaskbarBackgroundBrush}">
                    <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start with Windows" Checked="StartWithWindowsCheckBox_Changed" Unchecked="StartWithWindowsCheckBox_Changed" />
                    <CheckBox x:Name="AutoHideCheckBox" Content="Auto-hide taskbar" Checked="AutoHideCheckBox_Changed" Unchecked="AutoHideCheckBox_Changed" />
                    <CheckBox x:Name="ReserveSpaceCheckBox" Content="Reserve screen space (real Windows AppBar)" Checked="ReserveSpaceCheckBox_Changed" Unchecked="ReserveSpaceCheckBox_Changed" />
                    <TextBlock Text="Reserving screen space changes shared desktop state (other windows resize around it) — off by default." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TaskbarSubtleForegroundBrush}" Margin="20,0,0,0" />

                    <TextBlock Text="Applications" Style="{StaticResource SectionHeader}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Rescan Now" Click="RescanButton_Click" Style="{StaticResource TaskbarButtonStyle}" Padding="10,4" />
                        <TextBlock x:Name="AppCountText" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource TaskbarSubtleForegroundBrush}" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Appearance">
                <StackPanel Margin="8" Background="{StaticResource TaskbarBackgroundBrush}">
                    <TextBlock Text="Position" Style="{StaticResource SectionHeader}" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="PositionBottomRadio" Content="Bottom" GroupName="Position" Checked="PositionRadio_Changed" />
                        <RadioButton x:Name="PositionTopRadio" Content="Top" GroupName="Position" Checked="PositionRadio_Changed" />
                    </StackPanel>

                    <TextBlock Text="Height" Style="{StaticResource SectionHeader}" />
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="HeightSlider" Minimum="32" Maximum="64" Width="220" TickFrequency="4" IsSnapToTickEnabled="True" ValueChanged="HeightSlider_ValueChanged" />
                        <TextBlock x:Name="HeightValueText" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Keyboard">
                <StackPanel Margin="8" Background="{StaticResource TaskbarBackgroundBrush}">
                    <TextBlock Text="Launcher hotkey" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="Win+Space is the default but is frequently already claimed by Windows' own input-language switcher. Pick a different combination if the launcher doesn't respond to it." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TaskbarSubtleForegroundBrush}" Margin="0,0,0,8" />
                    <ComboBox x:Name="HotkeyComboBox" Width="200" HorizontalAlignment="Left" SelectionChanged="HotkeyComboBox_SelectionChanged" />
                    <TextBlock x:Name="HotkeyStatusText" Margin="0,8,0,0" FontSize="12" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Advanced">
                <StackPanel Margin="8" Background="{StaticResource TaskbarBackgroundBrush}">
                    <TextBlock Text="Configuration" Style="{StaticResource SectionHeader}" />
                    <Button Content="Open Config Folder" Click="OpenConfigFolder_Click" Style="{StaticResource TaskbarButtonStyle}" HorizontalContentAlignment="Left" Padding="8,5" Margin="0,0,0,6" />
                    <Button Content="Export Settings..." Click="Export_Click" Style="{StaticResource TaskbarButtonStyle}" HorizontalContentAlignment="Left" Padding="8,5" Margin="0,0,0,6" />
                    <Button Content="Import Settings..." Click="Import_Click" Style="{StaticResource TaskbarButtonStyle}" HorizontalContentAlignment="Left" Padding="8,5" Margin="0,0,0,6" />

                    <TextBlock Text="Reset" Style="{StaticResource SectionHeader}" />
                    <Button Content="Reset Configuration" Click="Reset_Click" Style="{StaticResource TaskbarButtonStyle}" HorizontalContentAlignment="Left" Padding="8,5" Foreground="#FF6B6B" />
                    <TextBlock Text="Backs up current categories/settings before resetting; applications are re-discovered on next rescan regardless." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TaskbarSubtleForegroundBrush}" Margin="0,4,0,0" />

                    <TextBlock Text="Safe Mode" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="Run FlexTaskbar.exe --safe-mode from a terminal to launch with all taskbar-replacement behavior disabled." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TaskbarSubtleForegroundBrush}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
    </Border>
</Window>
