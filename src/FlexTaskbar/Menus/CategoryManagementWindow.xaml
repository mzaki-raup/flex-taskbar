<Window x:Class="FlexTaskbar.Menus.CategoryManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Category"
        Width="340"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource TaskbarBackgroundBrush}"
        Foreground="{StaticResource TaskbarForegroundBrush}"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <StackPanel Margin="16">
        <TextBlock x:Name="HeaderText"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <Button x:Name="RenameButton" Content="Rename..." HorizontalContentAlignment="Left"
                Style="{StaticResource TaskbarButtonStyle}" Padding="8,6" Margin="0,0,0,6"
                Click="Rename_Click" />
        <Button x:Name="AddSubcategoryButton" Content="New Subcategory..." HorizontalContentAlignment="Left"
                Style="{StaticResource TaskbarButtonStyle}" Padding="8,6" Margin="0,0,0,6"
                Click="AddSubcategory_Click" />

        <TextBlock Text="Icon" FontSize="12" Foreground="{StaticResource TaskbarSubtleForegroundBrush}" Margin="0,4,0,4" />
        <WrapPanel x:Name="IconPickerPanel" Margin="0,0,0,6" />
        <Button x:Name="ChooseIconFileButton" Content="Choose from file... (PNG/ICO/SVG)" HorizontalContentAlignment="Left"
                Style="{StaticResource TaskbarButtonStyle}" Padding="8,6" Margin="0,0,0,10"
                Click="ChooseIconFile_Click" />

        <Button x:Name="DeleteButton" Content="Delete Category" HorizontalContentAlignment="Left"
                Style="{StaticResource TaskbarButtonStyle}" Padding="8,6" Margin="0,0,0,6"
                Foreground="#FF6B6B" Click="Delete_Click" />

        <Button Content="Close" Width="80" HorizontalAlignment="Right" Margin="0,12,0,0"
                Style="{StaticResource TaskbarButtonStyle}" Click="Close_Click" IsCancel="True" />
    </StackPanel>
</Window>
