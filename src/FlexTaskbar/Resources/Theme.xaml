<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Basic dark theme, modeled loosely on the Windows 11 taskbar.
        This is a minimal Phase 1 palette; full Light/Dark/System theming
        arrives with Settings/Appearance (Phase 7).
    -->

    <Color x:Key="TaskbarBackgroundColor">#DD202020</Color>
    <Color x:Key="TaskbarBorderColor">#33FFFFFF</Color>
    <Color x:Key="TaskbarForegroundColor">#FFFFFFFF</Color>
    <Color x:Key="TaskbarSubtleForegroundColor">#B3FFFFFF</Color>
    <Color x:Key="ItemHoverColor">#1AFFFFFF</Color>
    <Color x:Key="ItemPressedColor">#33FFFFFF</Color>
    <Color x:Key="AccentColor">#FF60CDFF</Color>

    <SolidColorBrush x:Key="TaskbarBackgroundBrush" Color="{StaticResource TaskbarBackgroundColor}" />
    <SolidColorBrush x:Key="TaskbarBorderBrush" Color="{StaticResource TaskbarBorderColor}" />
    <SolidColorBrush x:Key="TaskbarForegroundBrush" Color="{StaticResource TaskbarForegroundColor}" />
    <SolidColorBrush x:Key="TaskbarSubtleForegroundBrush" Color="{StaticResource TaskbarSubtleForegroundColor}" />
    <SolidColorBrush x:Key="ItemHoverBrush" Color="{StaticResource ItemHoverColor}" />
    <SolidColorBrush x:Key="ItemPressedBrush" Color="{StaticResource ItemPressedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

    <!-- Implicit (no x:Key) — applies to every Image in the app, anywhere,
         including Popups/ContextMenus/secondary windows (all separate visual-tree
         roots that wouldn't otherwise inherit a property set at, say, the main
         taskbar Window). WPF's default downscale quality left custom app/category
         icons looking soft even after CategoryIconService started rasterizing
         them at a much higher resolution (round feedback: "why is the icon for
         category and apps not sharp, even i use 512x512 png icon?" — two
         contributing causes, this being the second one; see CategoryIconService's
         IconSize comment for the first). -->
    <Style TargetType="Image">
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
    </Style>

    <Style x:Key="TaskbarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TaskbarForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ItemHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ItemPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
