<Window x:Class="FlexTaskbar.Taskbar.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:util="clr-namespace:FlexTaskbar.Utilities"
        Title="FlexTaskbar"
        Icon="pack://application:,,,/Resources/App.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        Background="{StaticResource TaskbarBackgroundBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <util:ApplicationIconConverter x:Key="AppIconConverter" />
    </Window.Resources>
    <Grid>
    <Border BorderBrush="{StaticResource TaskbarBorderBrush}" BorderThickness="0,1,0,0"
            AllowDrop="True"
            MouseRightButtonUp="Background_MouseRightButtonUp"
            MouseEnter="TaskbarWindow_MouseEnter"
            MouseLeave="TaskbarWindow_MouseLeave"
            DragEnter="Taskbar_DragEnter"
            DragOver="Taskbar_DragEnter"
            Drop="Taskbar_Drop">
        <Grid Margin="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: "All" (uncategorized apps, drag source) only. The Start button
                 was removed (round feedback: "act like an app launcher" — All Apps +
                 category shortcuts are the entry point now); "Link" moved to the far
                 right (round feedback: "put the link button icon also on the far
                 right on the left of settings icon"). Category icons live only in
                 the center panel now, blended with pinned app icons (round-4
                 feedback: remove the redundant left-side copies). -->
            <StackPanel x:Name="LeftPanel" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AllAppsButton"
                        Content="All"
                        Style="{StaticResource TaskbarButtonStyle}"
                        AllowDrop="True"
                        Click="AllAppsButton_Click"
                        DragEnter="AllAppsButton_DragOver"
                        DragOver="AllAppsButton_DragOver"
                        Drop="AllAppsButton_Drop" />
            </StackPanel>

            <!-- Center: category icons + pinned app shortcuts only (round feedback:
                 "remove opened apps display on the taskbar, remain only apps
                 category and apps shortcut" — no more running-window tracking).
                 The panel itself (not just individual buttons) is a drop target so
                 reordering works everywhere along the row, with a position
                 indicator showing where the dragged item will land (round
                 feedback: "i still cannot drag and drop category to the right
                 side... make a indicator that show where will the apps shortcut
                 and category will end up"). CenterPanelOverlay hosts that
                 indicator as a floating element rather than a real sibling inside
                 CenterPanel — CenterPanel is HorizontalAlignment="Center", so
                 inserting/removing a real sibling on every drag-over tick changed
                 its total width and made the *whole row* recenter and visibly jump
                 (round feedback: "it just exchange position with other category,
                 jump to the left and right"); an overlay never touches
                 CenterPanel's own layout. IsHitTestVisible="False" so it doesn't
                 intercept the drag/click events meant for CenterPanel underneath. -->
            <StackPanel x:Name="CenterPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                        AllowDrop="True"
                        DragEnter="CenterPanel_DragOver"
                        DragOver="CenterPanel_DragOver"
                        DragLeave="CenterPanel_DragLeave"
                        Drop="CenterPanel_Drop" />
            <Canvas x:Name="CenterPanelOverlay" Grid.Column="1" IsHitTestVisible="False" />

            <!-- Right: battery status (real data, only shown when a battery is
                 present) + "Link" (add a web app by URL) + Settings. Network status
                 and the volume-mixer shortcut were removed (round feedback: "remove
                 also network and volume mixer icon on the far right"); Settings
                 moved here from the right-click menu so it's a visible, discoverable
                 app control (round feedback: "put settings for apps on the far
                 right") instead of hidden behind a right-click. The mirrored system
                 tray icons and the clock/date were removed earlier (round feedback:
                 "remove system tray icon apps, date and time"). -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BatteryStatusButton"
                        Style="{StaticResource TaskbarButtonStyle}"
                        Padding="6,0"
                        Visibility="Collapsed"
                        Click="BatteryStatusButton_Click" />
                <Button x:Name="LinkButton"
                        Content="🔗 Link"
                        Style="{StaticResource TaskbarButtonStyle}"
                        Margin="0,0,10,0"
                        ToolTip="Add a website by URL, an executable (with arguments), or a shell:AppsFolder app"
                        Click="AddWebAppButton_Click" />
                <Button x:Name="SettingsButton"
                        Content="⚙"
                        Style="{StaticResource TaskbarButtonStyle}"
                        Padding="6,0"
                        ToolTip="Settings"
                        AutomationProperties.Name="Settings"
                        Click="SettingsButton_Click" />
            </StackPanel>
        </Grid>
    </Border>

    <Popup x:Name="AppsPopup"
           PlacementTarget="{Binding ElementName=AllAppsButton}"
           Placement="Top"
           StaysOpen="False"
           AllowsTransparency="True"
           PopupAnimation="Slide">
        <Border Background="{StaticResource TaskbarBackgroundBrush}"
                BorderBrush="{StaticResource TaskbarBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="4"
                MaxHeight="480"
                Width="280"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Margin="8,6,8,4"
                           Text="All Applications (drag onto a category to sort)"
                           Foreground="{StaticResource TaskbarSubtleForegroundBrush}"
                           FontSize="11"
                           TextWrapping="Wrap" />
                <ListBox x:Name="AppsListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="AppsListBox_SelectionChanged"
                         PreviewMouseLeftButtonDown="AppsListBox_PreviewMouseLeftButtonDown"
                         PreviewMouseLeftButtonUp="AppsListBox_PreviewMouseLeftButtonUp"
                         PreviewMouseMove="AppsListBox_PreviewMouseMove"
                         MouseRightButtonUp="AppsListBox_MouseRightButtonUp">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,3">
                                <Image Width="20" Height="20"
                                       Source="{Binding Converter={StaticResource AppIconConverter}}" />
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{StaticResource TaskbarForegroundBrush}"
                                           FontSize="13"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Popup>
    </Grid>
</Window>
