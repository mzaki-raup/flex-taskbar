<Window x:Class="FlexTaskbar.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:util="clr-namespace:FlexTaskbar.Utilities"
        Title="FlexTaskbar"
        Width="420"
        Height="520"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        Background="{StaticResource TaskbarBackgroundBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <util:ApplicationIconConverter x:Key="AppIconConverter" />

        <DataTemplate x:Key="AppListItemTemplate">
            <StackPanel Orientation="Horizontal" Margin="4,4">
                <Image Width="22" Height="22" Source="{Binding Converter={StaticResource AppIconConverter}}" />
                <TextBlock Text="{Binding Name}"
                           Foreground="{StaticResource TaskbarForegroundBrush}"
                           FontSize="13"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TaskbarSubtleForegroundBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="10,10,10,2" />
        </Style>

        <Style x:Key="LauncherListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource TaskbarBorderBrush}" BorderThickness="1" CornerRadius="8">
        <DockPanel>
            <TextBox x:Name="SearchBox"
                     DockPanel.Dock="Top"
                     Margin="10"
                     Padding="8,6"
                     FontSize="14"
                     Background="{StaticResource ItemHoverBrush}"
                     Foreground="{StaticResource TaskbarForegroundBrush}"
                     BorderThickness="0"
                     TextChanged="SearchBox_TextChanged"
                     PreviewKeyDown="SearchBox_PreviewKeyDown" />

            <Grid DockPanel.Dock="Bottom" Margin="10,6,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SettingsButton"
                        Grid.Column="0"
                        Content="⚙ Settings"
                        HorizontalAlignment="Left"
                        Style="{StaticResource TaskbarButtonStyle}"
                        Click="SettingsButton_Click" />
                <Button x:Name="PowerButton"
                        Grid.Column="1"
                        Content="⏻ Power"
                        Style="{StaticResource TaskbarButtonStyle}"
                        Click="PowerButton_Click" />
            </Grid>

            <Grid>
                <!-- Search results (shown while SearchBox has text) -->
                <DockPanel x:Name="ResultsPanel" Visibility="Collapsed">
                    <TextBlock DockPanel.Dock="Top" Text="Results" Style="{StaticResource SectionHeaderStyle}" />
                    <ListBox x:Name="ResultsListBox"
                             Style="{StaticResource LauncherListBoxStyle}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemTemplate="{StaticResource AppListItemTemplate}" />
                </DockPanel>

                <!-- Default content (shown while SearchBox is empty) -->
                <ScrollViewer x:Name="DefaultPanel" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="RecentHeader" Text="Recent" Style="{StaticResource SectionHeaderStyle}" />
                        <ListBox x:Name="RecentListBox"
                                 Style="{StaticResource LauncherListBoxStyle}"
                                 ItemTemplate="{StaticResource AppListItemTemplate}" />

                        <TextBlock x:Name="CategoriesHeader" Text="Categories" Style="{StaticResource SectionHeaderStyle}" />
                        <WrapPanel x:Name="CategoriesPanel" Margin="6,0,6,4" />

                        <TextBlock Text="All Applications" Style="{StaticResource SectionHeaderStyle}" />
                        <ListBox x:Name="AllAppsListBox"
                                 Style="{StaticResource LauncherListBoxStyle}"
                                 ItemTemplate="{StaticResource AppListItemTemplate}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
