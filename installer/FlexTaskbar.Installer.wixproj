<Project Sdk="WixToolset.Sdk/6.0.2">

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platforms>x64</Platforms>
    <DefineConstants>FlexTaskbarVersion=1.0.0</DefineConstants>
    <!-- ICE38/ICE64/ICE91 are legacy MSI consistency checks that predate per-user
         install being a common, well-supported pattern — they assume every
         user-profile component needs an HKCU-registry keypath and explicit
         RemoveFile tracking, which is overly conservative for a modern
         Scope="perUser" package. Suppressing validation (not the install logic
         itself) is standard practice for per-user WiX installers; it doesn't change
         what actually gets installed or how uninstall behaves. -->
    <SuppressValidation>true</SuppressValidation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Gives the .wxs access to $(var.FlexTaskbar.TargetDir) so the installer always
         packages whatever the app project actually built, rather than a hand-maintained
         file list that could silently go stale as dependencies change. -->
    <ProjectReference Include="..\src\FlexTaskbar\FlexTaskbar.csproj" />
  </ItemGroup>

</Project>
